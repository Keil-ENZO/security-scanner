# Scanner versions, one place for the Docker image and the CI. Bump them here
NUCLEI_VERSION=3.11.1
TRIVY_VERSION=0.76.1
# npm bundled with Node, upgraded in the image for its own dependency fixes
NPM_VERSION=11.21.1
# pnpm and Yarn fixes go through corepack, at the version each project pins
COREPACK_VERSION=0.36.0
SEMGREP_VERSION=1.180.0
SYFT_VERSION=1.55.0
GRYPE_VERSION=0.121.0
# Root of trust for the other downloads: the cosign binary is pinned by hash
COSIGN_VERSION=3.1.4
COSIGN_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
