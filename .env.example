# Session de l'interface, 32 caractères minimum : openssl rand -hex 32
NUXT_SESSION_PASSWORD=
# Mot de passe de l'interface, haché : node scripts/hash-password.mjs
NUXT_PASSWORD_HASH=
# Chiffrement des identifiants de test en base, 32 octets en hex : openssl rand -hex 32
NUXT_SECRET_KEY=

# Garde-fous : rien n'est scanné hors de ces listes
NUXT_ALLOWED_OWNERS=Keil-ENZO
NUXT_ALLOWED_HOSTS=keil-enzo.com,*.keil-enzo.com,aurefort.vercel.app,avisflow-plum.vercel.app,quitus-chi.vercel.app

# Facultatif : dépôts privés. Jeton fine-grained, lecture seule sur Contents
NUXT_GITHUB_TOKEN=

NUXT_OLLAMA_URL=http://127.0.0.1:11434
NUXT_OLLAMA_MODEL=qwen3.8:27b

# Facultatif : rapport sur Telegram
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
