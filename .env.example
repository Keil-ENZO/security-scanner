# Interface session, 32 characters minimum: openssl rand -hex 32
NUXT_SESSION_PASSWORD=
# false when the interface is served over plain HTTP, on a private network for instance
NUXT_SESSION_COOKIE_SECURE=true
# Interface password, hashed: node scripts/hash-password.mjs
NUXT_PASSWORD_HASH=
# Encryption of test credentials in the database, 32 bytes in hex: openssl rand -hex 32
NUXT_SECRET_KEY=

# Guardrails: nothing outside these lists is ever scanned. Comma separated
NUXT_ALLOWED_OWNERS=your-github-user,your-org
NUXT_ALLOWED_HOSTS=example.com,*.example.com,my-app.vercel.app

# Optional: private repositories, fixes and reviews. Fine-grained token, see README
NUXT_GITHUB_TOKEN=
NUXT_GIT_AUTHOR_NAME=Security Scanner
NUXT_GIT_AUTHOR_EMAIL=security-scanner@users.noreply.github.com
# Optional: shows the Vercel build log when a deployment fails
NUXT_VERCEL_TOKEN=

# Optional: report written by a local LLM. Empty: plain text report
NUXT_OLLAMA_URL=http://127.0.0.1:11434
NUXT_OLLAMA_MODEL=qwen3:8b

# Bearer token of the scheduler, 32 characters minimum: openssl rand -hex 32
NUXT_AUTOMATION_TOKEN=
# Interface address, for links in notifications
NUXT_PUBLIC_URL=http://127.0.0.1:3003
NUXT_PUBLIC_INSTANCE_NAME=security-scanner
NUXT_PUBLIC_TIME_ZONE=UTC
NUXT_PUBLIC_LOCALE=en-GB

# Optional notifications. Every channel that is set gets the message
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
NUXT_SLACK_WEBHOOK_URL=
NUXT_DISCORD_WEBHOOK_URL=
# Generic webhook: POST {"text": "..."}
NUXT_WEBHOOK_URL=
